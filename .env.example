# Copie para .env (o docker compose lê automaticamente). Valores de desenvolvimento local.

# Strapi
STRAPI_APP_KEYS=chave1,chave2,chave3,chave4
STRAPI_API_TOKEN_SALT=dev-api-token-salt
STRAPI_ADMIN_JWT_SECRET=dev-admin-jwt
STRAPI_JWT_SECRET=dev-jwt
STRAPI_TRANSFER_TOKEN_SALT=dev-transfer-salt
STRAPI_ENCRYPTION_KEY=dev-encryption-key-32-caracteres
PREVIEW_SECRET=dev-preview
# Usuário do admin (já existe no dump; usado se a base estiver vazia)
CMS_ADMIN_EMAIL=admin@hapvida.poc
CMS_ADMIN_PASSWORD=Hapvida123

# Tokens de API do Strapi (recriados no boot com estes valores)
SITE_API_TOKEN=dev-token-site
MCP_STRAPI_TOKEN=dev-token-mcp
MIGRACAO_API_TOKEN=dev-token-migracao

# Armazenamento de arquivos (RustFS, compatível com S3)
S3_ACCESS_KEY=hapvida
S3_SECRET_KEY=hapvida-segredo-s3

# Front: dev (recarrega ao editar) ou producao (build + start)
FRONT_MODO=dev

